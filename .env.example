# Use a fresh test-only account. Never commit a funded production key.
DEPLOYER_PRIVATE_KEY=0xYOUR_TEST_PRIVATE_KEY

# Testnet RPC endpoints. Provider URLs may contain account-specific tokens.
SEPOLIA_RPC_URL=https://YOUR_SEPOLIA_RPC_ENDPOINT
BSC_TESTNET_RPC_URL=https://YOUR_BSC_TESTNET_RPC_ENDPOINT
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Optional: copy generated figures to a local paper directory.
# CASTLE_PAPER_EXP=/absolute/path/to/paper/exp

# Private debugging only; do not enable for an anonymous artifact release.
# CASTLE_INCLUDE_RUN_METADATA=1
